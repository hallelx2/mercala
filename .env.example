# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# In the deployed stack these come from GitHub secrets/variables via Ansible, not from
# this file. AWS credentials are deliberately absent: CI assumes an IAM role via OIDC and
# the host uses an instance profile, so there are no AWS keys anywhere.

# --- Image generation -------------------------------------------------------
# Primary provider, then the ordered fallback chain.
# replicate | openai | pollinations | placeholder
MERCALA_IMAGE_GEN_PROVIDER=replicate
MERCALA_IMAGE_GEN_FALLBACK_CHAIN=pollinations,placeholder

# https://replicate.com/account/api-tokens
# Requires purchased credit — without it Replicate returns 402 and the chain falls
# through to Pollinations.
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-schnell
REPLICATE_ASPECT_RATIO=1:1
REPLICATE_OUTPUT_FORMAT=png

# --- OpenAI-compatible model (agent chat + optional image provider) ----------
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=glm-4-7

# --- Local infrastructure ---------------------------------------------------
# Defaults match docker-compose.yml; override only if you changed it.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mercala-images
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Secrets used by the deployed stack (set as GitHub secrets, not here) ----
# DB_PASSWORD, JWT_SECRET, OPENAI_API_KEY, REPLICATE_API_TOKEN
