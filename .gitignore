# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# NOTE: .mvn/wrapper/maven-wrapper.properties IS committed (required by the wrapper)

# Java
*.class
*.log
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# IDE - IntelliJ
.idea/
*.iml
*.iws
*.ipr
out/

# IDE - VS Code / Eclipse
.vscode/
.settings/
.classpath
.project
bin/

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
*.env

# Build / runtime
logs/

# Terraform (covers the root stack and devops/terraform/bootstrap)
**/.terraform/
*.tfstate
*.tfstate.*
# Variable files can carry secrets. *.tfvars alone does not match the JSON variants,
# so match those explicitly rather than leaving a gap.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
!*.tfvars.example
crash.log
# NOTE: .terraform.lock.hcl IS committed, deliberately. It pins provider versions and
# hashes, so CI resolves the same providers the change was tested against. Ignoring it
# would let a deploy silently pick up a new provider release.

# DevOps secrets (never commit)
devops/*.pem
devops/deploy-compose.yml
devops/deploy.sh

# Session worktrees are local machinery, never part of the repo
.claude/worktrees/
