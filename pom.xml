<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot BOM as the parent: manages dependency versions + Java config -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mercala</groupId>
    <artifactId>mercala-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mercala-parent</name>
    <description>Mercala — agent-native, multi-tenant e-commerce platform (monorepo parent)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Pinned above the Spring Boot BOM's 1.19.8, whose docker-java client negotiates
            Docker API 1.32. Docker has since raised its own floor to 1.40 and refuses that
            client outright — every Testcontainers test then fails with "Could not find a
            valid Docker environment", which reads as a broken machine rather than an old
            dependency. CI's runner image still ships an older daemon, so this goes red on a
            current developer machine while staying green in the build.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <!-- Modules. mercala-image-gen added in later milestone (M6). -->
    <modules>
        <module>mercala-contracts</module>
        <module>mercala-core</module>
        <module>mercala-agent</module>
        <module>mercala-image-gen</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0-M5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>7.4</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>2.2.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
