version: '3.8'

services:
  db:
    image: paradedb/paradedb:latest
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: {{ db_name }}
    volumes:
      - pgdata:/var/lib/postgresql
    deploy:
      resources:
        limits:
          memory: 256M
    restart: always

  kafka:
    image: apache/kafka:latest
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_LOG_DIRS: /tmp/kraft-combined-logs
      # Strict JVM heap limit for cheap instance
      KAFKA_HEAP_OPTS: "-Xmx256m -Xms128m"
    deploy:
      resources:
        limits:
          memory: 384M
    restart: always

  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
      # certbot writes the HTTP-01 challenge here on the host; nginx must serve it.
      - /var/www/certbot:/var/www/certbot:ro
    depends_on:
      - core
      - agent
      - image-gen
    deploy:
      resources:
        limits:
          memory: 64M
    restart: always

  core:
    image: {{ ecr_core_url }}:latest
    environment:
      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/{{ db_name }}
      SPRING_DATASOURCE_USERNAME: {{ db_user }}
      SPRING_DATASOURCE_PASSWORD: {{ db_password }}
      SPRING_FLYWAY_USERNAME: {{ db_user }}
      SPRING_FLYWAY_PASSWORD: {{ db_password }}
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      MERCALA_JWT_SECRET: {{ jwt_secret }}
      # Merchant photo uploads land in the same bucket image-gen writes to: an
      # enhancement reads the merchant's original from there and writes its result
      # beside it. Blank credentials for the same reason as image-gen below —
      # omitting them would fall back to application.yml's local "minioadmin"
      # defaults and authenticate to real S3 as a user that does not exist.
      MINIO_ENDPOINT: {{ s3_endpoint }}
      MINIO_BUCKET: {{ s3_bucket_name }}
      MINIO_ACCESS_KEY: ""
      MINIO_SECRET_KEY: ""
      MINIO_SESSION_TOKEN: ""
      AWS_REGION: {{ aws_region }}
      JAVA_OPTS: "-Xmx512m -Xms256m"
    depends_on:
      - db
      - kafka
    deploy:
      resources:
        limits:
          memory: 640M
    restart: always

  agent:
    image: {{ ecr_agent_url }}:latest
    environment:
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      SPRING_AI_OPENAI_API_KEY: {{ openai_api_key }}
      SPRING_AI_OPENAI_BASE_URL: {{ openai_base_url | default('http://nginx:8085', true) }}
      SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL: {{ openai_model | default('glm-4.5-air', true) }}
      MERCALA_CORE_BASE_URL: http://core:8080
      JAVA_OPTS: "-Xmx256m -Xms128m"
    depends_on:
      - kafka
    deploy:
      resources:
        limits:
          memory: 384M
    restart: always

  image-gen:
    image: {{ ecr_image_gen_url }}:latest
    environment:
      SPRING_KAFKA_BOOTSTRAP_SERVERS: kafka:9092
      SPRING_AI_OPENAI_API_KEY: {{ openai_api_key }}
      SPRING_AI_OPENAI_BASE_URL: {{ openai_base_url | default('https://generativelanguage.googleapis.com/v1beta/openai', true) }}
      SPRING_AI_OPENAI_IMAGE_OPTIONS_MODEL: {{ openai_image_model | default('cogview-3', true) }}
      MERCALA_IMAGE_GEN_PROVIDER: {{ image_gen_provider | default('cloudflare', true) }}
      CLOUDFLARE_ACCOUNT_ID: "{{ cloudflare_account_id }}"
      CLOUDFLARE_API_TOKEN: "{{ cloudflare_api_token }}"
      CLOUDFLARE_IMAGE_MODEL: "{{ cloudflare_image_model | default('@cf/black-forest-labs/flux-1-schnell', true) }}"
      REPLICATE_API_TOKEN: "{{ replicate_api_token }}"
      REPLICATE_MODEL: {{ replicate_model | default('black-forest-labs/flux-schnell', true) }}
      MINIO_ENDPOINT: {{ s3_endpoint }}
      MINIO_BUCKET: {{ s3_bucket_name }}
      # Explicitly blank, not omitted. application.yml defaults these to "minioadmin"
      # for local MinIO, so omitting them here would leave the container authenticating
      # to real S3 with minioadmin/minioadmin instead of the instance profile. Blank
      # values are what make the storage client resolve credentials from instance
      # metadata.
      MINIO_ACCESS_KEY: ""
      MINIO_SECRET_KEY: ""
      MINIO_SESSION_TOKEN: ""
      AWS_REGION: {{ aws_region }}
      JAVA_OPTS: "-Xmx256m -Xms128m"
    depends_on:
      - kafka
    deploy:
      resources:
        limits:
          memory: 384M
    restart: always

volumes:
  pgdata:
